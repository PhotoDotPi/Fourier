# ============================================
# FOURIER BOT CONFIGURATION
# ============================================
# Replace the placeholder values below with your actual API keys

DISCORD_TOKEN=your-discord-bot-token-here
DATA_DIR=./data
YOUTUBE_API_KEY=your-youtube-api-key-here
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

############
# Optional #
############

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Direct connection URL (not pooled) for the long-running bot process.
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ============================================
# PERFORMANCE & CACHING
# ============================================
# Increase cache size for better performance and faster playback
CACHE_LIMIT=2GB

# ============================================
# ENHANCED FEATURES
# ============================================
# Enable SponsorBlock to skip non-music segments (intros, ads, etc.)
ENABLE_SPONSORBLOCK=false
# Delay (in minutes) before retrying when SponsorBlock server is unreachable
SPONSORBLOCK_TIMEOUT=5

# ============================================
# YT-DLP CONFIGURATION
# ============================================
# Fourier looks for a bundled yt-dlp binary at <project root>/bin/yt-dlp by
# default. Drop a standalone yt-dlp binary there (no sudo needed) or override
# the path explicitly.
# YT_DLP_PATH=/path/to/bin/yt-dlp
# Auto-update yt-dlp for best YouTube compatibility
YT_DLP_AUTO_UPDATE=false

# ============================================
# AGE-RESTRICTED CONTENT SUPPORT
# ============================================
# Enable playback of age-restricted YouTube videos
# Requires exporting cookies from age-verified YouTube account
# See: https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# YT_DLP_COOKIES_PATH=/path/to/youtube-cookies.txt

# ============================================
# FOURIER BOT CUSTOMIZATION
# ============================================
# Bot Status: online, idle, or dnd
BOT_STATUS=online

# Activity Type: PLAYING, LISTENING, WATCHING, or STREAMING
BOT_ACTIVITY_TYPE=LISTENING

# Custom activity text (what appears after the activity type)
BOT_ACTIVITY=music

# Streaming URL (required only if using STREAMING activity type)
# BOT_ACTIVITY_URL=https://www.twitch.tv/your_channel

# ============================================
# ADVANCED BOT SETTINGS
# ============================================
# Register commands bot-wide instead of per-guild (useful for 10+ guilds)
# Command updates can take up to an hour to propagate
# REGISTER_COMMANDS_ON_BOT=true
